# Copy to .env and fill in real values. Never commit .env (it is git-ignored and docker-ignored).

# --- MLflow on DagsHub (Task 3) - green "Experiments" dropdown on the DagsHub repo
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/23L-0871_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub_username>
MLFLOW_TRACKING_PASSWORD=<dagshub_token>

# --- PostgreSQL (Task 5/6) - used by docker-compose.yml
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=<choose_a_password>
POSTGRES_DB=visionguard

# --- Web app (Task 4) - empty THRESHOLD = use the threshold saved with the champion model
THRESHOLD=
MAX_UPLOAD_MB=5

# --- Cloud model API (Task 7/8): INFERENCE_MODE=remote makes the app call the API instead of loading TF
INFERENCE_MODE=local
MODEL_API_URL=https://<your-api-host>
API_KEY=<long_random_secret>
